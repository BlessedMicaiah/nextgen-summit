# Next Gen Summit on Hostinger.
Options -Indexes

# The review site is served from a folder inside this one. It must only ever be reached as
# staging.nextgensummit.us, never as nextgensummit.us/staging/, so on any other host that
# path does not exist. The review site ships this same file, and a folder's own rewrite rules
# replace its parent's, so the test uses the full request path: it holds in either place.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^staging\. [NC]
  RewriteCond %{REQUEST_URI} ^/staging(/|$) [NC]
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Never serve local database files, even if one ends up in the public folder.
<FilesMatch "\.(sqlite|sqlite3|db|jsonl)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Photos, fonts, scripts and styles can be cached; pages always revalidate.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
