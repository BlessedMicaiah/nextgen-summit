# One directory per contestant, served by one file.
#   /pitch/peoples-choice/semifinalist-07/  ->  entrant.php?slug=semifinalist-07
# The gallery itself, the admin dashboard and real files are left alone.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /pitch/peoples-choice/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9][a-z0-9-]{1,80})/?$ entrant.php?slug=$1 [L,QSA]
</IfModule>
